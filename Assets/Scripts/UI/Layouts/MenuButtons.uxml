<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
>
    <Style src="MenuButtons.uss" />
    <ui:VisualElement name="horizontal-end">
        <ui:VisualElement name="vertical-top">
            <ui:Button class="overlay-button" name="settings" text="Settings" />
            <ui:Button class="overlay-button" name="games" text="Games" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
#container {
	flex-grow: 1;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 100%;
	background-color: white;
}

#horizontal-end {
	flex-grow: 1;
	flex-direction: row;
	justify-content: flex-end;
	align-items: flex-start;
	width: 80%;
	max-height: 45px;
	margin-bottom: 10px;
}

#horizontal-start {
	flex-grow: 1;
	flex-direction: row;
	align-items: flex-start;
	width: 80%;
	height: 100%;
	margin-bottom: 5px;
}

#vertical-scroller {
	width: 100%;
	height: 100%;
}

.rules-text {
	color: black;
	white-space: normal;
}

.close-button {
	background-color: white;
	border-color: white;
}

.unity-scroller__high-button {
	background-color: white;
	border-color: white;
}

.unity-scroller__low-button {
	background-color: white;
	border-color: white;
}

.unity-scroller__slider {
	background-color: white;
	border-color: white;
}

.unity-base-slider__tracker {
	background-color: white;
	border-color: white;
}

.unity-base-slider__dragger {
	border-radius: 10px;
	background-color: gray;
}

.bold {
	-unity-font-style: bold;
}

.header {
	font-size: 20px;
	margin-top: 5px;
	margin-bottom: 10px;
}

.subheader {
	font-size: 16px;
	margin-top: 10px;
	margin-bottom: 3px;
}

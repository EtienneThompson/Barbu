#column {
    flex-grow: 1;
    flex-direction: column;
    align-items: flex-end;
    width: 100%;
}

#row {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0.8);
    width: 50%;
}

.games-button {
    width: 96%;
    background-color: rgba(150, 150, 150, 0.8);
    border-color: black;
    border-radius: 10px;
    color: white;
}

#container {
    flex-grow: 1;
    flex-direction: column;
    background-color: white;
    width: 100%;
    height: 100%;
}

#content-row {
    flex-grow: 1;
    flex-direction: row;
}

#settings-column {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
}

#settings-row {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    max-height: 30px;
    width: 100%;
}

#row {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-start;
}

#header-row {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    background-color: rgba(40, 161, 41, 1);
    width: 100%;
    max-height: 40px;
}

#left-column {
    width: 40%;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 10px;
}

#right-column {
    width: 60%;
    flex-direction: column;
    align-items: flex-start;
}

#left-notch-spacer, #right-notch-spacer {
    flex-shrink: 0;
    height: 100%;
}

.header {
    font-size: 20px;
    -unity-font-style: bold;
}

.arrow-button {
    height: 30px;
    border-color: transparent;
    background-color: transparent;
}

.settings-button {
    border-color: transparent;
    border-radius: 10px;
    height: 30px;
    -unity-font-style: bold;
}

.selection-box {
    width: 100px;
}

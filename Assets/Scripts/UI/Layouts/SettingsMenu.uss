#container {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    background-color: white;
    width: 100%;
    height: 100%;
}

#generic-column {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    width: 90%;
    height: 100%;
}


#row {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
}

#header-row {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    background-color: rgba(40, 161, 41, 1);
    width: 100%;
    max-height: 40px;
}

#left-column {
    flex-grow: 1;
    flex-direction: column;
    align-items: flex-start;
    margin-left: 25px;
}

#right-column {
    flex-grow: 1;
    flex-direction: column;
    align-items: flex-end;
    margin-right: 25px;
}

.header {
    font-size: 20px;
    -unity-font-style: bold;
}

.arrow-button {
    height: 30px;
    border-color: transparent;
    background-color: transparent;
}

.settings-button {
    border-color: transparent;
    border-radius: 10px;
    height: 30px;
    -unity-font-style: bold;
}

.selection-box {
    width: 100px;
}
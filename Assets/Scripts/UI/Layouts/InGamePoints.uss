#container {
	flex-grow: 1;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	width: 100%;
}

#generic-row {
	flex-grow: 1;
	flex-direction: row;
	width: 90%;
	height: 100%;
}

#left-column {
	flex-grow: 1;
	flex-direction: column;
	justify-content: flex-start;
	align-items: flex-start;
	height: 100%;
	width: 30%;
}

#middle-column {
	flex-grow: 1;
	flex-direction: column;
	height: 100%;
	width: 100%;
}

#right-column {
	flex-grow: 1;
	flex-direction: column;
	width: 30%;
}

#top-points-row {
	flex-grow: 1;
	flex-direction: row;
	height: 100%;
	width: 100%;
}

#bottom-points-row {
	flex-grow: 1;
	flex-direction: row;
	height: 100%;
	width: 100%;
}

#left-points-section {
	flex-grow: 1;
	flex-direction: column;
	width: 100%;
	height: 100%;
	justify-content: center;
	align-items: center;
}

#right-points-section {
	flex-grow: 1;
	flex-direction: column;
	width: 100%;
	height: 100%;
	justify-content: center;
	align-items: center;
}

#top-right-row {
	flex-grow: 1;
	flex-direction: row;
	justify-content: flex-end;
	width: auto;
	height: 100%;
}

#bottom-right-row {
	flex-grow: 1;
	flex-direction: row;
	justify-content: flex-end;
	align-items: flex-end;
	width: auto;
	height: 100%;
}

#button-column {
	width: 40px;
}

.point-container {
	background-color: black;
}

.point-label {
	font-size: 10px;
	color: #9F9F9F;
	margin: 0;
	padding: 0;
}

.point-circle {
	background-color: black;
	rotate: 45deg;
	height: 30px;
	width: 30px;
	-unity-text-align: middle-center;
}

.circle-1 {
	border-top-right-radius: 50%;
	border-bottom-left-radius: 50%;
	border-bottom-right-radius: 50%;
}

.circle-2 {
	border-top-left-radius: 50%;
	border-bottom-left-radius: 50%;
	border-bottom-right-radius: 50%;
}

.circle-3 {
	border-top-left-radius: 50%;
	border-top-right-radius: 50%;
	border-bottom-right-radius: 50%;
}

.circle-4 {
	border-top-left-radius: 50%;
	border-top-right-radius: 50%;
	border-bottom-left-radius: 50%;
}

.point-text {
	color: white;
	rotate: -45deg;
}

.overlay-button {
    font-size: 5px;
    height: 25px;
    width: 30px;
	border-radius: 5px;
	background-color: white;
	border-color: white;
}

.button-text {
	color: #000000;
	-unity-font-style: bold;
}
